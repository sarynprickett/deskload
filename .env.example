# Local development. Never commit this file.
DATABASE_URL="postgresql://USER@localhost:5432/deskload_dev?schema=public"

# Session signing secret (local dev value — generate a fresh one for production).
AUTH_SECRET="run: openssl rand -base64 32"

# Set to "1" to expose the local no-password user switcher at /signin.
# This is force-disabled whenever NODE_ENV=production.
DEV_LOGIN="1"

# Google OAuth (optional — leave blank until you create a Google Cloud OAuth client).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
